# Google Gemini API key. Get one at https://aistudio.google.com/apikey
# If left unset, Misko still runs fully — the diagnosis/hint layer falls back to
# deterministic templates instead of Gemini (see src/lib/ai/fallback.ts).
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash
